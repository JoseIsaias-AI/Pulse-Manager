{
  "name": "pulse-mais-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:local": "set DB_TYPE=sqljs&& ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/backend/database/migrate.ts",
    "seed": "ts-node src/backend/database/seed.ts",
    "db:test": "ts-node src/scripts/test-db.ts",
    "supabase:check": "ts-node src/scripts/test-db.ts",
    "risco:recalcular": "ts-node src/scripts/recalcular-risco-evasao.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test -c src/tests/e2e/playwright.config.ts",
    "test:unit": "jest --runInBand src/tests/unit",
    "test:integration": "jest --runInBand src/tests/integration",
    "test:performance": "node src/tests/run-performance-tests.js --runInBand src/tests/integration --testNamePattern=RNF-DES",
    "test:ci": "npm run test && npm run test:performance",
    "build": "tsc",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/src/server.js')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "sql.js": "^1.12.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
